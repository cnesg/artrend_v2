<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd job: every day 07:00 local time; the script holds the push until 08:30 (set the Mac to KST). Install with scripts/install_schedule.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.artrend.daily</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/scripts/daily_update.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ARTREND_PIPELINE</key><string>__PIPELINE__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/artrend_daily.out</string>
  <key>StandardErrorPath</key><string>/tmp/artrend_daily.err</string>
</dict>
</plist>
